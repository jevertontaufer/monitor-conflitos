# Credenciais da sua conta myACLED (registre-se em https://acleddata.com/user/register)
# Use, de preferência, o e-mail institucional para herdar o nível de acesso da organização.
ACLED_EMAIL=jevertont@gmail.com
ACLED_PASSWORD=#Swordfish@2030

# Porta do servidor (opcional)
PORT=8787

# Origem permitida para CORS. Deixe * para testes locais; em produção,
# coloque o domínio onde a página está hospedada, ex.: https://seusite.com
ALLOWED_ORIGIN=*

# Janela de análise em dias e tempo de cache em minutos (opcionais)
WINDOW_DAYS=30
CACHE_MIN=20

# Modo de teste: 1 = devolve dados de exemplo sem chamar a ACLED
# (deixe comentado/0 quando tiver credenciais reais)
# ACLED_MOCK=1
